<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Check Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Atlantis Java style gate (Checkstyle). Run: bash scripts/checkstyle.sh
  Scope: src/ ONLY (production code and tests). src-old/ and everything else
  are never checked.

  A rule is listed here only if the tree is green under it; a red-on-day-one
  rule helps nobody. Deliberately DEFERRED (measured 2026-10-21, counts on
  src/ with 1443 files):
  - UnusedImports (477 hits, fixed in setup): KEPT on senior decision
    2026-10-21 despite the commented-code concern. Reason: this script runs
    on demand (~1/200 commits), never as a gate, so you run it on FINISHED
    work - commented-out WIP and a lint sweep never meet. At that cadence
    the churn tax is ~zero, while dead imports are the largest hygiene
    signal in the tree. Guidance is in scripts/checkstyle.sh: run after a
    feature lands, not mid-refactor.
  - NeedBraces (4687 hits): the codebase writes braceless single-statement
    ifs everywhere. Enforcing braces would be a style revolution, not a gate.
  - AvoidStarImport (100 hits in 89 files): entrenched, same reason.
  - LineLength (61 lines over 140): rewraps need human judgment per line.
  - EqualsHashCode (1 hit, INVERTED: ARegion defines hashCode() without
    equals()): adding equals() would change equality semantics. Dropped, not
    fixed - a check must never demand a behavior change.
  - Indentation (998 hits) / EmptyLineSeparator (1489 hits): churn
    class, measured 2026-10-21. The tree was never formatted by a tool, so
    enforcing layout retroactively means thousands of judgment-free diffs
    that bury real history (git blame) for zero behavior gain. New code
    follows the neighbors; no gate. Kept from this family only the two
    zero-burden micro-rules: NoWhitespaceBefore (2 hits, fixed) and
    WhitespaceAfter (1 hit, fixed).
-->
<module name="Checker">
  <!-- Owner file Main.java is fully excluded (never touch, never gate).
    Withdrawing the UnusedImports sweep that wrongly removed one import
    here (commit 26f7c2fe4) would otherwise re-flag it every run; the
    working tree already restores the import, the file stays uncommitted
    for the owner (NEXT #164). Inline filter, not SuppressionFilter:
    the CLI does not resolve ${config_loc} (measured 2026-10-21). -->
  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value="src[/\\]main[/\\]Main\.java$"/>
  </module>
  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="Trailing whitespace."/>
  </module>
  <!-- Blank line after every single-line return (empty or valued) that real
    code follows. EXEMPT by design, both measured 2026-10-21:
    - returns immediately before '}' (7616 of 7787 literal hits - forcing a
      blank before the brace is noise, and it would split '} else {' /
      '} catch {');
    - returns followed only by comments (67 of the 171 first-pass fixes
      stood before '//' / '/*' / '*' lines - separating live code from
      dead commentary is the same noise class).
    Limitation: multi-line returns ('return foo(' ...) are not matched -
    the ';' must sit on the return's own line. -->
  <module name="RegexpMultiline">
    <property name="format" value="^[ \t]*return\b[^;\n]*;[ \t]*\n(?![ \t]*(?:\r?\n|\}|//|/\*|\*))"/>
    <property name="message" value="Return must be followed by a blank line."/>
  </module>
  <!-- Same rule for guard-style one-line returns ('if (...) return ...;').
    Added 2026-10-22: the line-start rule above is blind to them, so files
    full of guard clauses passed while violating the spirit of the rule.
    Same exemptions as the rule above (brace, blank, comment-only next
    line - separating live returns from comments is the same noise class
    as blank-before-brace, measured 2026-10-21 with 67 blanks dropped);
    single-line methods and trailing '}' lines stay untouched by construction. -->
  <module name="RegexpMultiline">
    <property name="format" value="^[ \t]*(?:else[ \t]+)?if\b.*\breturn\b[^;\n]*;[ \t]*\n(?![ \t]*(?:\r?\n|\}|//|/\*|\*))"/>
    <property name="message" value="Return must be followed by a blank line (guard style)."/>
  </module>
  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="EmptyStatement"/>
    <module name="NoWhitespaceBefore"/>
    <module name="WhitespaceAfter"/>
  </module>
</module>
